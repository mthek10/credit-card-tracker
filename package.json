{
  "name": "credit-card-rewards",
  "version": "1.0.0",
  "description": "Credit card wallet tracker to monitor benefits and annual fees",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "NODE_ENV=production node server/src/index.js",
    "postinstall": "npm run build || true"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
